{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/versions\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\n\\w+: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Same dependency, own PR, release-notes cache key changed by sourceDirectory",
      "matchFileNames": ["escape/**"],
      "additionalBranchPrefix": "escape-",
      "commitMessageSuffix": "(cache key escaped)",
      "sourceDirectory": "deploy/charts/rook-ceph"
    }
  ]
}
